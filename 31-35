@bot.group(name="tts", invoke_without_command=True)
async def tts_group(ctx):
    """Text-to-speech commands."""
    await ctx.send(embed=bleed_embed("TTS", "`<voice> <text>`, `voices`, `join`, `leave`\nUsage: `,tts <voice> <text>`"))

@tts_group.command(name="voices")
async def tts_voices(ctx):
    """List available TTS voices."""
    await ctx.send(embed=bleed_embed("TTS Voices", "Available voices: en-US, en-GB, fr-FR, de-DE, es-ES, ja-JP, ko-KR, pt-BR, and more."))

@tts_group.command(name="join")
async def tts_join(ctx):
    """Make the bot join your voice channel for TTS."""
    voice = ctx.author.voice
    if not voice:
        return await ctx.send(embed=error_embed("Join a voice channel first."))
    try:
        await voice.channel.connect()
        await ctx.send(embed=bleed_embed("TTS", f"Joined {voice.channel.mention}"))
    except discord.Forbidden:
        await ctx.send(embed=error_embed("Missing permissions to join voice."))
    except discord.HTTPException as e:
        await ctx.send(embed=error_embed(str(e)))

@tts_group.command(name="leave")
async def tts_leave(ctx):
    """Make the bot leave the voice channel."""
    voice = ctx.guild.voice_client
    if voice:
        await voice.disconnect()
        await ctx.send(embed=bleed_embed("TTS", "Left voice channel."))
    else:
        await ctx.send(embed=error_embed("Not in a voice channel."))


