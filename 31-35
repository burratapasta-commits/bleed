@bot.command(name="permissions", aliases=["perms"])
async def permissions_cmd(ctx, member: discord.Member = None):
    """Show a member's permissions in the current channel."""
    m = member or ctx.author
    perms = ctx.channel.permissions_for(m)
    granted = [perm.replace("_", " ").title() for perm, value in perms if value]
    denied = [perm.replace("_", " ").title() for perm, value in perms if not value]
    embed = discord.Embed(title=f"Permissions: {m.name}", color=0x9B59B6)
    embed.set_footer(text="bleed.bot")
    if granted:
        embed.add_field(name=f"✅ Granted ({len(granted)})", value=", ".join(granted[:15]) + ("..." if len(granted) > 15 else ""), inline=False)
    if denied:
        embed.add_field(name=f"❌ Denied ({len(denied)})", value=", ".join(denied[:15]) + ("..." if len(denied) > 15 else ""), inline=False)
    await ctx.send(embed=embed)

