@bot.command(name="prefix")
@commands.has_permissions(administrator=True)
async def prefix_cmd(ctx, symbol: str = None):
    """Change or view the server prefix."""
    if symbol:
        if len(symbol) > 10:
            return await ctx.send(embed=error_embed("Prefix must be 10 characters or less."))
        db.execute("INSERT OR REPLACE INTO prefixes VALUES (?,?)", (ctx.guild.id, symbol))
        await ctx.send(embed=bleed_embed("Prefix", f"Set to `{symbol}`"))
    else:
        await ctx.send(embed=bleed_embed("Prefix", f"Current: `{get_prefix(ctx.guild.id)}`"))

