@bot.command(name="snipe")
async def snipe_cmd(ctx):
    """Snipe the last deleted message in this channel."""
    msg = bot.snipe_cache.get(ctx.channel.id)
    if not msg:
        return await ctx.send(embed=bleed_embed("Snipe", "Nothing to snipe."))
    embed = discord.Embed(description=msg.content or "*[no text]*", color=0x9B59B6, timestamp=msg.created_at)
    embed.set_author(name=msg.author.name, icon_url=msg.author.display_avatar.url)
    embed.set_footer(text="bleed.bot • Sniped")
    if msg.attachments:
        embed.set_image(url=msg.attachments[0].url)
    await ctx.send(embed=embed)

@bot.command(name="editsnipe")
async def editsnipe_cmd(ctx):
    """Snipe the last edited message."""
    data = bot.editsnipe_cache.get(ctx.channel.id)
    if not data:
        return await ctx.send(embed=bleed_embed("Edit Snipe", "Nothing to snipe."))
    embed = discord.Embed(color=0xFFA500, timestamp=datetime.utcnow())
    embed.set_author(name=data.get("author", "Unknown"))
    embed.add_field(name="Before", value=data.get("before", "*[empty]*")[:1000], inline=False)
    embed.add_field(name="After", value=data.get("after", "*[empty]*")[:1000], inline=False)
    embed.set_footer(text="bleed.bot • Edit Sniped")
    await ctx.send(embed=embed)

@bot.command(name="invites", aliases=["inv"])
async def invites_cmd(ctx, member: discord.Member = None):
    """Check invite count for a member."""
    m = member or ctx.author
    try:
        invites = await ctx.guild.invites()
        user_invites = [inv for inv in invites if inv.inviter and inv.inviter.id == m.id]
        total_uses = sum(inv.uses for inv in user_invites)
        embed = discord.Embed(title=f"Invites: {m.name}", color=0x9B59B6)
        embed.set_footer(text="bleed.bot")
        embed.add_field(name="Total Invites", value=str(len(user_invites)), inline=True)
        embed.add_field(name="Total Uses", value=str(total_uses), inline=True)
        await ctx.send(embed=embed)
    except discord.Forbidden:
        await ctx.send(embed=error_embed("Missing permissions to view invites."))
