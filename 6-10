    """Import all reactions from a message as reaction roles."""
    try:
        parts = message_link.split("/")
        msg_id = int(parts[-1])
        ch_id = int(parts[-2])
    except:
        return await ctx.send(embed=error_embed("Invalid message link."))
    ch = ctx.guild.get_channel(ch_id)
    if not ch:
        return await ctx.send(embed=error_embed("Channel not found."))
    try:
        msg = await ch.fetch_message(msg_id)
    except:
