@bot.group(name="tickets", aliases=["ticket", "tix"], invoke_without_command=True)
async def tickets_group(ctx):
    """Open a support ticket."""
    r = db.fetchone("SELECT category_id, ticket_count, max_tickets FROM tickets WHERE guild_id=?", (ctx.guild.id,))
    if not r or not r[0]:
        return await ctx.send(embed=error_embed("Ticket system not configured. An admin must run `,tickets panel`."))
    bl = db.fetchone("SELECT * FROM ticket_blacklist WHERE guild_id=? AND user_id=?", (ctx.guild.id, ctx.author.id))
    if bl:
        return await ctx.send(embed=error_embed("You are blacklisted from creating tickets."))
    existing = db.fetchall("SELECT * FROM open_tickets WHERE guild_id=? AND user_id=?", (ctx.guild.id, ctx.author.id))
    if len(existing) >= (r[2] or 5):
        return await ctx.send(embed=error_embed("You have reached the maximum number of open tickets."))
    cat = ctx.guild.get_channel(r[0])
    if not cat:
        return await ctx.send(embed=error_embed("Ticket category not found."))
    ow = {
        ctx.guild.default_role: discord.PermissionOverwrite(view_channel=False),
        ctx.author: discord.PermissionOverwrite(view_channel=True, send_messages=True)
    }
    for sr in db.fetchall("SELECT role_id FROM ticket_staff WHERE guild_id=?", (ctx.guild.id,)):
        role = ctx.guild.get_role(sr[0])
        if role:
            ow[role] = discord.PermissionOverwrite(view_channel=True, send_messages=True)
    ch = await ctx.guild.create_text_channel(f"ticket-{r[1]+1}", category=cat, overwrites=ow)
    db.execute("UPDATE tickets SET ticket_count=ticket_count+1 WHERE guild_id=?", (ctx.guild.id,))
    db.execute("INSERT INTO open_tickets (guild_id, channel_id, user_id, opened_at) VALUES (?,?,?,?)", (ctx.guild.id, ch.id, ctx.author.id, time.time()))
    await ch.send(embed=bleed_embed("Ticket Opened", f"{ctx.author.mention}'s support ticket.\nStaff will assist shortly.\nUse `,tickets close` to close."))
    await ctx.send(embed=bleed_embed("Ticket", f"Created {ch.mention}"))

