@boosterrole_group.command(name="cleanup")
async def boosterrole_cleanup(ctx):
    """Remove roles for members who are no longer boosting."""
    rows = db.fetchall("SELECT user_id, role_id FROM booster_roles WHERE guild_id=? AND user_id != 0", (ctx.guild.id,))
    cleaned = 0
    for user_id, role_id in rows:
        member = ctx.guild.get_member(user_id)
        if not member or not member.premium_since:
            role = ctx.guild.get_role(role_id)
            if role:
                try:
                    await role.delete()
                except:
                    pass
            db.execute("DELETE FROM booster_roles WHERE guild_id=? AND user_id=?", (ctx.guild.id, user_id))
            cleaned += 1
    await ctx.send(embed=bleed_embed("Cleanup", f"Cleaned up {cleaned} booster roles."))

