@tickets_group.command(name="transcript")
@commands.has_permissions(manage_channels=True)
async def tickets_transcript(ctx):
    """Generate a transcript of the current ticket."""
    r = db.fetchone("SELECT * FROM open_tickets WHERE guild_id=? AND channel_id=?", (ctx.guild.id, ctx.channel.id))
    if not r:
        return await ctx.send(embed=error_embed("This is not a ticket channel."))
    messages = []
    async for msg in ctx.channel.history(limit=500, oldest_first=True):
        messages.append(f"[{msg.created_at.strftime('%Y-%m-%d %H:%M:%S')}] {msg.author}: {msg.content}")
    transcript = "\n".join(messages)
    if len(transcript) > 1900:
        buffer = io.StringIO(transcript)
        await ctx.send(file=discord.File(buffer, filename=f"transcript-{ctx.channel.name}.txt"))
    else:
        await ctx.send(embed=bleed_embed("Transcript", f"```{transcript[:1900]}```"))

