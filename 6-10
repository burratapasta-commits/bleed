@levels_group.command(name="ignore")
async def levels_ignore(ctx, channel: discord.TextChannel):
    """Ignore or unignore a channel for XP gain."""
    r = db.fetchone("SELECT ignored_channels FROM level_config WHERE guild_id=?", (ctx.guild.id,))
    ignored = (r[0] or "").split(",") if r and r[0] else []
    ch_id = str(channel.id)
    if ch_id in ignored:
        ignored.remove(ch_id)
        status = "unignored"
    else:
        ignored.append(ch_id)
        status = "ignored"
    db.execute("UPDATE level_config SET ignored_channels=? WHERE guild_id=?", (",".join(ignored), ctx.guild.id))
    await ctx.send(embed=bleed_embed("Levels", f"{channel.mention} {status} for XP."))

