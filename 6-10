@tickets_group.command(name="close")
@commands.has_permissions(manage_channels=True)
async def tickets_close(ctx):
    """Close and delete the current ticket."""
    r = db.fetchone("SELECT * FROM open_tickets WHERE guild_id=? AND channel_id=?", (ctx.guild.id, ctx.channel.id))
    if not r:
        return await ctx.send(embed=error_embed("This is not a ticket channel."))
    db.execute("DELETE FROM open_tickets WHERE guild_id=? AND channel_id=?", (ctx.guild.id, ctx.channel.id))
    await ctx.send(embed=bleed_embed("Closing", "This ticket will be deleted in 5 seconds..."))
    await asyncio.sleep(5)
    try:
        await ctx.channel.delete()
    except (discord.Forbidden, discord.HTTPException):
        pass

