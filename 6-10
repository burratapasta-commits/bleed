@levels_group.command(name="sync")
async def levels_sync(ctx):
    """Sync roles to members based on their current level."""
    rows = db.fetchall("SELECT level, role_id FROM level_roles WHERE guild_id=? ORDER BY level", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Level Sync", "No level roles configured."))
    updated = 0
    for member in ctx.guild.members:
        user_row = db.fetchone("SELECT level FROM levels WHERE guild_id=? AND user_id=?", (ctx.guild.id, member.id))
        if user_row:
            user_level = user_row[0]
            for lvl, role_id in rows:
                role = ctx.guild.get_role(role_id)
                if role:
                    if user_level >= lvl and role not in member.roles:
                        try:
                            await member.add_roles(role)
                            updated += 1
                        except:
                            pass
    await ctx.send(embed=bleed_embed("Level Sync", f"Synced roles for {updated} members."))

