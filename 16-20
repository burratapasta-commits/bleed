@voicemaster_group.command(name="category")
async def voicemaster_category(ctx, category: discord.CategoryChannel):
    """Set the category where VoiceMaster channels are created."""
    db.execute("UPDATE voicemaster SET category_id=? WHERE guild_id=?", (category.id, ctx.guild.id))
    await ctx.send(embed=bleed_embed("Category Set", f"New VM channels will be created in **{category.name}**"))

@voicemaster_group.command(name="default")
async def voicemaster_default(ctx, setting: str = None, *, value: str = None):
    """Set default settings. Usage: ,vm default name/bitrate/limit/region <value>"""
    if not setting or not value:
        return await ctx.send(embed=bleed_embed("VM Defaults", "`name`, `bitrate`, `limit`, `region`"))
    if setting == "name":
        db.execute("UPDATE voicemaster SET default_name=? WHERE guild_id=?", (value, ctx.guild.id))
        await ctx.send(embed=bleed_embed("Default Name", f"Set to `{value}`"))
    elif setting == "bitrate":
        try:
            br = int(value) * 1000
            db.execute("UPDATE voicemaster SET default_bitrate=? WHERE guild_id=?", (br, ctx.guild.id))
            await ctx.send(embed=bleed_embed("Default Bitrate", f"Set to {value}kbps"))
        except ValueError:
            await ctx.send(embed=error_embed("Invalid bitrate. Example: `64`"))
    elif setting == "limit":
        try:
            lim = int(value)
            db.execute("UPDATE voicemaster SET default_limit=? WHERE guild_id=?", (lim, ctx.guild.id))
            await ctx.send(embed=bleed_embed("Default Limit", f"Set to {lim} users"))
        except ValueError:
            await ctx.send(embed=error_embed("Invalid limit. Example: `5`"))
    elif setting == "region":
        db.execute("UPDATE voicemaster SET default_region=? WHERE guild_id=?", (value, ctx.guild.id))
        await ctx.send(embed=bleed_embed("Default Region", f"Set to `{value}`"))

