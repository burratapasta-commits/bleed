async def starboard_group(ctx):
    """Starboard configuration — highlight messages with ⭐ reactions."""
    await ctx.send(embed=bleed_embed("Starboard", "`unlock`, `lock`, `set`, `ignore`, `ignore list`, `threshold`, `emoji`, `selfstar`, `color`, `timestamp`, `jumpurl`, `attachments`, `reset`, `config`"))

@starboard_group.command(name="unlock")
async def starboard_unlock(ctx):
    """Unlock the starboard so it starts tracking."""
    db.execute("INSERT OR REPLACE INTO starboard (guild_id, locked) VALUES (?,0)", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Starboard", "Starboard unlocked and active."))

@starboard_group.command(name="lock")
async def starboard_lock(ctx):
    """Lock the starboard to pause tracking."""
    db.execute("UPDATE starboard SET locked=1 WHERE guild_id=?", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Starboard", "Starboard locked."))

@starboard_group.command(name="set")
async def starboard_set(ctx, channel: discord.TextChannel):
    """Set the starboard channel where starred messages appear."""
    db.execute("INSERT OR REPLACE INTO starboard (guild_id, channel_id) VALUES (?,?)", (ctx.guild.id, channel.id))
    await ctx.send(embed=bleed_embed("Starboard Channel", f"Set to {channel.mention}"))

@starboard_group.command(name="ignore")
async def starboard_ignore(ctx, target: Union[discord.TextChannel, discord.Role, discord.Member]):
    """Ignore a channel, role, or member from the starboard."""
    db.execute("INSERT OR IGNORE INTO logging_ignores (guild_id, target_id, target_type) VALUES (?,?,?)", (ctx.guild.id, target.id, type(target).__name__))
    await ctx.send(embed=bleed_embed("Starboard Ignore", f"{target.mention if hasattr(target, 'mention') else target.name} ignored."))

@starboard_group.command(name="threshold")
async def starboard_threshold(ctx, count: int):
    """Set how many ⭐ reactions are needed to appear on starboard."""
    count = max(1, min(count, 100))
    db.execute("UPDATE starboard SET threshold=? WHERE guild_id=?", (count, ctx.guild.id))
    await ctx.send(embed=bleed_embed("Starboard Threshold", f"Set to **{count}** reactions."))

