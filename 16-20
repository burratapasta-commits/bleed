@bot.group(name="log", invoke_without_command=True)
@commands.has_permissions(administrator=True)
async def log_group(ctx):
    """Server logging configuration."""
    await ctx.send(embed=bleed_embed("Logging", "`add`, `remove`, `ignore`, `ignore list`, `list`, `config`, `export`, `reset`\nEvents: messages, members, roles, channels, invites, emojis, voice, server"))

@log_group.command(name="add")
async def log_add(ctx, channel: discord.TextChannel, *, event: str):
    """Add a logging event to a channel."""
    valid_events = ["messages", "members", "roles", "channels", "invites", "emojis", "voice", "server"]
    event = event.lower()
    if event not in valid_events:
        return await ctx.send(embed=error_embed(f"Valid events: {', '.join(valid_events)}"))
    db.execute("INSERT OR REPLACE INTO logging VALUES (?,?,?)", (ctx.guild.id, event, channel.id))
    await ctx.send(embed=bleed_embed("Logging Added", f"**{event}** events → {channel.mention}"))

@log_group.command(name="remove")
async def log_remove(ctx, *, event: str):
    """Remove a logging event."""
    db.execute("DELETE FROM logging WHERE guild_id=? AND event=?", (ctx.guild.id, event.lower()))
    await ctx.send(embed=bleed_embed("Logging Removed", f"`{event}` logging removed."))

@log_group.command(name="ignore")
async def log_ignore(ctx, target: Union[discord.Member, discord.TextChannel]):
    """Ignore a member or channel from logs."""
    target_type = "member" if isinstance(target, discord.Member) else "channel"
    r = db.fetchone("SELECT * FROM logging_ignores WHERE guild_id=? AND target_id=?", (ctx.guild.id, target.id))
    if r:
        db.execute("DELETE FROM logging_ignores WHERE guild_id=? AND target_id=?", (ctx.guild.id, target.id))
        await ctx.send(embed=bleed_embed("Logging", f"{target.mention if hasattr(target, 'mention') else target.name} unignored."))
    else:
        db.execute("INSERT INTO logging_ignores VALUES (?,?,?)", (ctx.guild.id, target.id, target_type))
        await ctx.send(embed=bleed_embed("Logging", f"{target.mention if hasattr(target, 'mention') else target.name} ignored from logs."))

@log_group.command(name="list")
async def log_list(ctx):
    """List all logging events and ignored targets."""
    events = db.fetchall("SELECT event, channel_id FROM logging WHERE guild_id=?", (ctx.guild.id,))
    ignores = db.fetchall("SELECT target_id, target_type FROM logging_ignores WHERE guild_id=?", (ctx.guild.id,))
    embed = discord.Embed(title="Logging Configuration", color=0x9B59B6)
    embed.set_footer(text="bleed.bot • Logging")
    if events:
        embed.add_field(name="Active Events", value="\n".join([f"• **{e[0]}** → <#{e[1]}>" for e in events]), inline=False)
    else:
        embed.add_field(name="Active Events", value="None configured", inline=False)
    if ignores:
        embed.add_field(name="Ignored", value="\n".join([f"• <@{i[0]}>" if i[1] == "member" else f"• <#{i[0]}>" for i in ignores]), inline=False)
    await ctx.send(embed=embed)

@log_group.command(name="config")
async def log_config(ctx):
    """Alias for log list."""
    await log_list(ctx)

@log_group.command(name="export")
async def log_export(ctx):
    """Export logging configuration as JSON."""
    events = db.fetchall("SELECT event, channel_id FROM logging WHERE guild_id=?", (ctx.guild.id,))
    if not events:
        return await ctx.send(embed=bleed_embed("Export", "No logging configured."))
    data = [{"event": e[0], "channel_id": e[1]} for e in events]
    json_str = json.dumps(data, indent=2)
    if len(json_str) > 1900:
        buffer = io.StringIO(json_str)
        await ctx.send(file=discord.File(buffer, filename="logging_config.json"))
    else:
        await ctx.send(embed=bleed_embed("Logging Export", f"```json\n{json_str}\n```"))

@log_group.command(name="reset")
async def log_reset(ctx):
    """Reset all logging configuration."""
    db.execute("DELETE FROM logging WHERE guild_id=?", (ctx.guild.id,))
    db.execute("DELETE FROM logging_ignores WHERE guild_id=?", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Logging Reset", "All logging cleared."))


