        await ctx.send(embed=bleed_embed("Rejected", f"{member.mention} removed from channel."))

@voicemaster_group.command(name="role")
async def voicemaster_role(ctx, role: discord.Role = None):
    """Set a role that members receive when joining YOUR channel."""
    if role:
        await ctx.send(embed=bleed_embed("Channel Role", f"{role.mention} will be given to members who join your channel."))
    else:
        await ctx.send(embed=bleed_embed("Channel Role", "Role cleared."))

@voicemaster_group.command(name="claim")
async def voicemaster_claim(ctx):
    """Claim an abandoned voice channel."""
    for ch in ctx.guild.voice_channels:
        if len(ch.members) == 0 and ch.id != db.fetchone("SELECT channel_id FROM voicemaster WHERE guild_id=?", (ctx.guild.id,))[0]:
            db.execute("INSERT OR REPLACE INTO voicemaster_owners VALUES (?,?,?)", (ctx.guild.id, ctx.author.id, ch.id))
            await ctx.send(embed=bleed_embed("Claimed", f"You now own {ch.mention}"))
            return
    await ctx.send(embed=error_embed("No abandoned channels to claim."))

@voicemaster_group.command(name="transfer")
async def voicemaster_transfer(ctx, member: discord.Member):
    """Transfer ownership of your voice channel."""
    r = db.fetchone("SELECT channel_id FROM voicemaster_owners WHERE guild_id=? AND user_id=?", (ctx.guild.id, ctx.author.id))
    if not r:
        return await ctx.send(embed=error_embed("You don't own a voice channel."))
    db.execute("UPDATE voicemaster_owners SET user_id=? WHERE guild_id=? AND channel_id=?", (member.id, ctx.guild.id, r[0]))
    await ctx.send(embed=bleed_embed("Transferred", f"Channel ownership transferred to {member.mention}"))

