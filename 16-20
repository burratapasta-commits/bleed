@voicemaster_group.command(name="config")
async def voicemaster_config(ctx):
    """View VoiceMaster configuration."""
    r = db.fetchone("SELECT * FROM voicemaster WHERE guild_id=?", (ctx.guild.id,))
    if not r:
        return await ctx.send(embed=bleed_embed("VoiceMaster", "Not configured. Use `,voicemaster setup`."))
    embed = discord.Embed(title="VoiceMaster Configuration", color=0x9B59B6)
    embed.set_footer(text="bleed.bot • VoiceMaster")
    embed.add_field(name="Join Channel", value=f"<#{r[1]}>" if r[1] else "Not set", inline=True)
    embed.add_field(name="Category", value=f"<#{r[2]}>" if r[2] else "None", inline=True)
    embed.add_field(name="Default Name", value=r[4] or "{user}'s VC", inline=True)
    embed.add_field(name="Default Bitrate", value=f"{r[3]//1000}kbps" if r[3] else "64kbps", inline=True)
    embed.add_field(name="Default Limit", value=str(r[5]) if r[5] else "No limit", inline=True)
    embed.add_field(name="Join Role", value=f"<@&{r[6]}>" if r[6] else "None", inline=True)
    await ctx.send(embed=embed)


