    embed.add_field(name="Self-Star", value="Yes" if r[4] else "No", inline=True)
    embed.add_field(name="Color", value=f"#{r[5]:06X}", inline=True)
    embed.add_field(name="Timestamp", value="On" if r[8] else "Off", inline=True)
    embed.add_field(name="Jump URL", value="On" if r[9] else "Off", inline=True)
    embed.add_field(name="Attachments", value="On" if r[10] else "Off", inline=True)
    await ctx.send(embed=embed)


