@bot.group(name="autoresponder", invoke_without_command=True)
@commands.has_permissions(administrator=True)
async def autoresponder_group(ctx):
    """Auto responder management."""
    await ctx.send(embed=bleed_embed("Auto Responders", "`add`, `remove`, `update`, `reset`, `list`, `exclusive`, `role`, `channel`, `config`, `import`"))

@autoresponder_group.command(name="add")
async def autoresponder_add(ctx, trigger: str, *, response: str):
    """
    Add an auto responder.
    Flags: --not_strict (partial match), --self_destruct (auto-delete response),
           --delete (delete trigger), --reply (reply mode), --ignore_command_check
    """
    db.execute("INSERT OR REPLACE INTO auto_responders (guild_id, trigger_text, response) VALUES (?,?,?)", (ctx.guild.id, trigger.lower(), response))
    await ctx.send(embed=bleed_embed("Auto Responder Added", f"`{trigger}` → `{response[:100]}`"))

@autoresponder_group.command(name="remove")
async def autoresponder_remove(ctx, *, trigger: str):
    """Remove an auto responder."""
    db.execute("DELETE FROM auto_responders WHERE guild_id=? AND trigger_text=?", (ctx.guild.id, trigger.lower()))
    await ctx.send(embed=bleed_embed("Auto Responder Removed", f"`{trigger}` removed."))

@autoresponder_group.command(name="update")
async def autoresponder_update(ctx, trigger: str, *, response: str):
    """Update an existing auto responder's response."""
    r = db.fetchone("SELECT * FROM auto_responders WHERE guild_id=? AND trigger_text=?", (ctx.guild.id, trigger.lower()))
    if not r:
        return await ctx.send(embed=error_embed(f"Trigger `{trigger}` not found."))
    db.execute("UPDATE auto_responders SET response=? WHERE guild_id=? AND trigger_text=?", (response, ctx.guild.id, trigger.lower()))
    await ctx.send(embed=bleed_embed("Auto Responder Updated", f"`{trigger}` response updated."))

@autoresponder_group.command(name="reset")
async def autoresponder_reset(ctx):
    """Reset all auto responders."""
    db.execute("DELETE FROM auto_responders WHERE guild_id=?", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Reset", "All auto responders cleared."))

@autoresponder_group.command(name="list")
async def autoresponder_list(ctx):
    """List all auto responders."""
    rows = db.fetchall("SELECT trigger_text, response FROM auto_responders WHERE guild_id=? LIMIT 25", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Auto Responders", "None configured."))
    msg = "\n".join([f"• `{r[0]}` → {r[1][:80]}" for r in rows])
    await ctx.send(embed=bleed_embed("Auto Responders", msg))

@autoresponder_group.command(name="exclusive")
async def autoresponder_exclusive(ctx, toggle: str = "on"):
    """Toggle exclusive mode — only one response per message."""
    en = 1 if toggle.lower() == "on" else 0
    db.execute("INSERT OR REPLACE INTO autoresponder_config (guild_id, exclusive) VALUES (?,?)", (ctx.guild.id, en))
    await ctx.send(embed=bleed_embed("Exclusive Mode", f"{'Enabled' if en else 'Disabled'}"))

@autoresponder_group.command(name="role")
async def autoresponder_role(ctx, trigger: str, role: discord.Role = None):
    """Restrict an auto responder to a specific role."""
    if role:
        db.execute("UPDATE auto_responders SET role_id=? WHERE guild_id=? AND trigger_text=?", (role.id, ctx.guild.id, trigger.lower()))
        await ctx.send(embed=bleed_embed("Role Restricted", f"`{trigger}` restricted to {role.mention}"))
    else:
        db.execute("UPDATE auto_responders SET role_id=NULL WHERE guild_id=? AND trigger_text=?", (ctx.guild.id, trigger.lower()))
        await ctx.send(embed=bleed_embed("Role Restriction Removed", f"`{trigger}` available to everyone."))

@autoresponder_group.command(name="channel")
async def autoresponder_channel(ctx, trigger: str, channel: discord.TextChannel = None):
    """Restrict an auto responder to a specific channel."""
    if channel:
        db.execute("UPDATE auto_responders SET channel_id=? WHERE guild_id=? AND trigger_text=?", (channel.id, ctx.guild.id, trigger.lower()))
        await ctx.send(embed=bleed_embed("Channel Restricted", f"`{trigger}` restricted to {channel.mention}"))
    else:
        db.execute("UPDATE auto_responders SET channel_id=NULL WHERE guild_id=? AND trigger_text=?", (ctx.guild.id, trigger.lower()))
        await ctx.send(embed=bleed_embed("Channel Restriction Removed", f"`{trigger}` available in all channels."))

@autoresponder_group.command(name="config")
async def autoresponder_config(ctx):
    """View auto responder configuration."""
    rows = db.fetchall("SELECT COUNT(*) FROM auto_responders WHERE guild_id=?", (ctx.guild.id,))
    exclusive = db.fetchone("SELECT exclusive FROM autoresponder_config WHERE guild_id=?", (ctx.guild.id,))
    embed = discord.Embed(title="Auto Responder Configuration", color=0x9B59B6)
    embed.set_footer(text="bleed.bot • Auto Responders")
    embed.add_field(name="Total Responders", value=str(rows[0][0] if rows else 0), inline=True)
    embed.add_field(name="Exclusive Mode", value="Yes" if exclusive and exclusive[0] else "No", inline=True)
    await ctx.send(embed=embed)

