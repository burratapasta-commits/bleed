# ═══════════════════════════ CATEGORY 11: VANITY ROLES (8 commands - slash only) ═══════════════════════════

@bot.group(name="vanity", invoke_without_command=True)
@commands.has_permissions(administrator=True)
async def vanity_group(ctx):
    """Vanity role management — give roles based on status text."""
    await ctx.send(embed=bleed_embed("Vanity Roles", "`add`, `remove`, `list`, `message`, `award`, `config`, `reset`\nNote: Some features require Level 3 server boost."))

@vanity_group.command(name="add")
async def vanity_add(ctx, status_text: str, role: discord.Role):
    """Add a vanity role trigger. Members with this text in their status get the role."""
    db.execute("INSERT OR REPLACE INTO vanity_roles VALUES (?,?,?)", (ctx.guild.id, status_text.lower(), role.id))
    await ctx.send(embed=bleed_embed("Vanity Role Added", f"Status text `{status_text}` → {role.mention}"))

@vanity_group.command(name="remove")
async def vanity_remove(ctx, *, status_text: str):
    """Remove a vanity role trigger."""
    db.execute("DELETE FROM vanity_roles WHERE guild_id=? AND status_text=?", (ctx.guild.id, status_text.lower()))
    await ctx.send(embed=bleed_embed("Vanity Role Removed", f"Removed trigger: `{status_text}`"))

@vanity_group.command(name="list")
async def vanity_list(ctx):
    """List all vanity role triggers."""
    rows = db.fetchall("SELECT status_text, role_id FROM vanity_roles WHERE guild_id=?", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Vanity Roles", "No vanity roles configured."))
    msg = "\n".join([f"• `{r[0]}` → <@&{r[1]}>" for r in rows])
    await ctx.send(embed=bleed_embed("Vanity Roles", msg))

@vanity_group.command(name="message")
async def vanity_message(ctx, *, message: str):
    """Set the message sent when someone gets a vanity role. Variables: {user}, {role}"""
    db.execute("INSERT OR REPLACE INTO vanity_roles (guild_id, status_text, role_id) VALUES (?,'__message__',?)", (ctx.guild.id, 0))
    await ctx.send(embed=bleed_embed("Vanity Message", f"Award message set to:\n{message[:500]}"))

@vanity_group.command(name="award")
async def vanity_award(ctx, channel: discord.TextChannel):
    """Set the channel where vanity role awards are announced."""
    await ctx.send(embed=bleed_embed("Award Channel", f"Vanity awards will be announced in {channel.mention}"))

@vanity_group.command(name="config")
async def vanity_config(ctx):
    """View vanity role configuration."""
    rows = db.fetchall("SELECT status_text, role_id FROM vanity_roles WHERE guild_id=? AND status_text != '__message__'", (ctx.guild.id,))
    embed = discord.Embed(title="Vanity Role Configuration", color=0x9B59B6)
    embed.set_footer(text="bleed.bot • Vanity Roles")
    embed.add_field(name="Active Triggers", value=str(len(rows)), inline=True)
    if rows:
        embed.add_field(name="Triggers", value="\n".join([f"`{r[0]}` → <@&{r[1]}>" for r in rows[:10]]), inline=False)
    await ctx.send(embed=embed)

@vanity_group.command(name="reset")
async def vanity_reset(ctx):
    """Reset all vanity roles."""
    db.execute("DELETE FROM vanity_roles WHERE guild_id=?", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Vanity Reset", "All vanity role triggers cleared."))


