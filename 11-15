@reaction_group.command(name="export")
async def reaction_export(ctx):
    """Export all reaction triggers as JSON."""
    rows = db.fetchall("SELECT trigger_text, emoji, owner_only FROM reaction_triggers WHERE guild_id=?", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Export", "No triggers to export."))
    data = [{"trigger": r[0], "emoji": r[1], "owner_only": bool(r[2])} for r in rows]
    json_str = json.dumps(data, indent=2)
    if len(json_str) > 1900:
        buffer = io.StringIO(json_str)
        await ctx.send(file=discord.File(buffer, filename="reaction_triggers.json"))
    else:
        await ctx.send(embed=bleed_embed("Reaction Triggers Export", f"```json\n{json_str}\n```"))
