# ═══════════════════════════ CATEGORY 14: AUTO MESSAGES / TIMERS (6 commands) ═══════════════════════════

@bot.group(name="timer", invoke_without_command=True)
@commands.has_permissions(administrator=True)
async def timer_group(ctx):
    """Scheduled recurring messages."""
    await ctx.send(embed=bleed_embed("Timers", "`add`, `remove`, `view`, `list`, `pause`, `resume`"))

@timer_group.command(name="add")
async def timer_add(ctx, channel: discord.TextChannel, interval: str, *, message: str):
    """
    Schedule a recurring message.
    Interval format: 1h, 30m, 1d, 6h
    """
    secs = parse_duration(interval)
    if not secs or secs < 60:
        return await ctx.send(embed=error_embed("Invalid interval. Minimum 60 seconds. Use: `1h`, `30m`, `1d`"))
    db.execute("INSERT OR REPLACE INTO timers (guild_id, channel_id, interval_secs, message, last_run, paused) VALUES (?,?,?,?,?,0)", (ctx.guild.id, channel.id, secs, message, time.time()))
    await ctx.send(embed=bleed_embed("Timer Added", f"Channel: {channel.mention}\nInterval: {format_duration(secs)}\nMessage:\n{message[:200]}"))

@timer_group.command(name="remove")
async def timer_remove(ctx, channel: discord.TextChannel):
    """Remove a scheduled timer from a channel."""
    db.execute("DELETE FROM timers WHERE guild_id=? AND channel_id=?", (ctx.guild.id, channel.id))
    await ctx.send(embed=bleed_embed("Timer Removed", f"Timer for {channel.mention} removed."))

@timer_group.command(name="view")
async def timer_view(ctx, channel: discord.TextChannel):
    """View a specific timer's configuration."""
    r = db.fetchone("SELECT interval_secs, message, last_run, paused FROM timers WHERE guild_id=? AND channel_id=?", (ctx.guild.id, channel.id))
    if not r:
        return await ctx.send(embed=error_embed("No timer configured for this channel."))
    embed = discord.Embed(title=f"Timer: {channel.name}", color=0x9B59B6)
    embed.set_footer(text="bleed.bot • Timers")
    embed.add_field(name="Interval", value=format_duration(r[0]), inline=True)
    embed.add_field(name="Status", value="Paused" if r[3] else "Active", inline=True)
    embed.add_field(name="Message", value=r[1][:500], inline=False)
    await ctx.send(embed=embed)

@timer_group.command(name="list")
async def timer_list(ctx):
    """List all active timers."""
    rows = db.fetchall("SELECT channel_id, interval_secs, paused FROM timers WHERE guild_id=?", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Timers", "No timers configured."))
    msg = "\n".join([f"• <#{r[0]}> — {format_duration(r[1])} — {'Paused' if r[2] else 'Active'}" for r in rows])
    await ctx.send(embed=bleed_embed("Active Timers", msg))

@timer_group.command(name="pause")
async def timer_pause(ctx, channel: discord.TextChannel):
    """Pause a timer."""
    r = db.fetchone("SELECT * FROM timers WHERE guild_id=? AND channel_id=?", (ctx.guild.id, channel.id))
    if not r:
        return await ctx.send(embed=error_embed("No timer in this channel."))
    db.execute("UPDATE timers SET paused=1 WHERE guild_id=? AND channel_id=?", (ctx.guild.id, channel.id))
    await ctx.send(embed=bleed_embed("Timer Paused", f"Timer for {channel.mention} paused."))

@timer_group.command(name="resume")
async def timer_resume(ctx, channel: discord.TextChannel):
    """Resume a paused timer."""
    r = db.fetchone("SELECT * FROM timers WHERE guild_id=? AND channel_id=?", (ctx.guild.id, channel.id))
    if not r:
        return await ctx.send(embed=error_embed("No timer in this channel."))
    db.execute("UPDATE timers SET paused=0, last_run=? WHERE guild_id=? AND channel_id=?", (time.time(), ctx.guild.id, channel.id))
    await ctx.send(embed=bleed_embed("Timer Resumed", f"Timer for {channel.mention} resumed."))


