    """Pagination and embed scripting."""
    await ctx.send(embed=bleed_embed("Pagination", "`set`, `add`, `update`, `remove`, `delete`, `reset`, `list`, `view`, `restorereactions`, `import`, `export`, `config`"))

@pagination_group.command(name="set")
async def pagination_set(ctx, *, name: str):
    """Create a new pagination."""
    db.execute("INSERT OR REPLACE INTO pagination (guild_id, name, content) VALUES (?,?,?)", (ctx.guild.id, name.lower(), "[]"))
    await ctx.send(embed=bleed_embed("Pagination Created", f"`{name}` created. Add pages with `,pagination add`."))

@pagination_group.command(name="add")
async def pagination_add(ctx, name: str, *, content: str):
    """Add a page to a pagination."""
    r = db.fetchone("SELECT content FROM pagination WHERE guild_id=? AND name=?", (ctx.guild.id, name.lower()))
    if not r:
        return await ctx.send(embed=error_embed(f"Pagination `{name}` not found."))
    try:
        pages = json.loads(r[0])
    except:
        pages = []
    pages.append(content)
    db.execute("UPDATE pagination SET content=? WHERE guild_id=? AND name=?", (json.dumps(pages), ctx.guild.id, name.lower()))
    await ctx.send(embed=bleed_embed("Page Added", f"Page {len(pages)} added to `{name}`."))

@pagination_group.command(name="update")
async def pagination_update(ctx, name: str, page: int, *, content: str):
    """Update a specific page."""
    r = db.fetchone("SELECT content FROM pagination WHERE guild_id=? AND name=?", (ctx.guild.id, name.lower()))
    if not r:
        return await ctx.send(embed=error_embed(f"Pagination `{name}` not found."))
    try:
        pages = json.loads(r[0])
    except:
        pages = []
    if page < 1 or page > len(pages):
        return await ctx.send(embed=error_embed(f"Page {page} out of range (1-{len(pages)})."))
    pages[page-1] = content
    db.execute("UPDATE pagination SET content=? WHERE guild_id=? AND name=?", (json.dumps(pages), ctx.guild.id, name.lower()))
    await ctx.send(embed=bleed_embed("Page Updated", f"Page {page} of `{name}` updated."))

@pagination_group.command(name="remove")
async def pagination_remove(ctx, name: str, page: int):
    """Remove a page from a pagination."""
    r = db.fetchone("SELECT content FROM pagination WHERE guild_id=? AND name=?", (ctx.guild.id, name.lower()))
    if not r:
        return await ctx.send(embed=error_embed(f"Pagination `{name}` not found."))
    try:
        pages = json.loads(r[0])
    except:
        pages = []
    if page < 1 or page > len(pages):
        return await ctx.send(embed=error_embed(f"Page out of range."))
    pages.pop(page-1)
    db.execute("UPDATE pagination SET content=? WHERE guild_id=? AND name=?", (json.dumps(pages), ctx.guild.id, name.lower()))
    await ctx.send(embed=bleed_embed("Page Removed", f"Page {page} removed from `{name}`."))

@pagination_group.command(name="delete")
async def pagination_delete(ctx, *, name: str):
    """Delete an entire pagination."""
    db.execute("DELETE FROM pagination WHERE guild_id=? AND name=?", (ctx.guild.id, name.lower()))
    await ctx.send(embed=bleed_embed("Pagination Deleted", f"`{name}` deleted."))

@pagination_group.command(name="reset")
async def pagination_reset(ctx):
    """Reset all paginations."""
    db.execute("DELETE FROM pagination WHERE guild_id=?", (ctx.guild.id,))
    await ctx.send(embed=bleed_embed("Reset", "All paginations cleared."))

@pagination_group.command(name="list")
async def pagination_list(ctx):
    """List all paginations."""
    rows = db.fetchall("SELECT name FROM pagination WHERE guild_id=?", (ctx.guild.id,))
    if not rows:
        return await ctx.send(embed=bleed_embed("Paginations", "None configured."))
    await ctx.send(embed=bleed_embed("Paginations", ", ".join([f"`{r[0]}`" for r in rows])))

@pagination_group.command(name="view")
async def pagination_view(ctx, *, name: str):
