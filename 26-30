@pagination_group.command(name="export")
async def pagination_export(ctx, *, name: str):
    """Export a pagination as JSON."""
    r = db.fetchone("SELECT content FROM pagination WHERE guild_id=? AND name=?", (ctx.guild.id, name.lower()))
    if not r:
        return await ctx.send(embed=error_embed(f"Pagination `{name}` not found."))
    if len(r[0]) > 1900:
        buffer = io.StringIO(r[0])
        await ctx.send(file=discord.File(buffer, filename=f"pagination_{name}.json"))
    else:
        await ctx.send(embed=bleed_embed(f"Pagination: {name}", f"```json\n{r[0][:1900]}\n```"))

